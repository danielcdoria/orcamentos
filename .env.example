# Modelo do arquivo .env (sem valores reais). Copie para .env e preencha.
#
# São DOIS bancos na Neon (dois "branches" do mesmo projeto):
#   - production: dados reais. Usado pela Vercel e pelo arquivo .env.producao
#   - dev:        testes. Usado pelo Mac (arquivo .env)
# Os dois arquivos (.env e .env.producao) ficam fora do git.

# Conexão com pooler (endereço com "-pooler" no host). Usada pelo site.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=verify-full"

# Conexão direta (mesmo endereço, sem "-pooler"). Usada pelas migrations do Prisma.
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=verify-full"
