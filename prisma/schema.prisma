// Descrição das tabelas do banco. Cada "model" vira uma tabela.
// Depois de mudar este arquivo, rode: npx prisma migrate dev --name descricao-da-mudanca

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// REGRAS DO PROJETO
// 1. Dinheiro sempre em CENTAVOS, como Int. R$ 12,50 é guardado como 1250.
// 2. Todo registro tem empresaId, e toda consulta filtra por ele.
//    É isso que permite várias empresas usando o mesmo sistema sem ver os dados umas das outras.

model Empresa {
  id                String   @id @default(cuid())
  nome              String
  logoUrl           String?
  telefone          String?
  condicaoPagamento String? // ex.: "50% na aprovação, 50% na entrega"
  diasValidade      Int      @default(15) // validade padrão dos orçamentos, em dias
  criadoEm          DateTime @default(now())

  // PIX (opcional): só é MOSTRADO na página do orçamento, com um botão de copiar a chave.
  // O sistema não recebe, não gera QR code e não confere pagamento nenhum.
  chavePix         String?
  nomeRecebedorPix String? // nome que o banco do cliente mostra ao pagar (ajuda a confiar)

  // Mensagem do botão "Enviar no WhatsApp". {cliente}, {link} etc. são trocados na hora.
  mensagemEnvio String @default("Olá {nome}, segue o orçamento que combinamos: {link}")

  // REGRA DE COBRANÇA (dias contados a partir do envio, enquanto o cliente não responde)
  prazoCobranca1 Int @default(2) // 1ª cobrança
  prazoCobranca2 Int @default(7) // 2ª cobrança
  prazoPerdido   Int @default(15) // marca como perdido e para de cobrar

  // Modelos das mensagens de cobrança: diferentes para quem abriu e quem não abriu o link.
  msgCobranca1NaoAbriu String @default("Oi, {nome}! Tudo bem? Te mandei o orçamento da {empresa} há uns dias, mas acho que acabou se perdendo aí no meio das mensagens. Vou deixar o link de novo aqui: {link}")
  msgCobranca1Abriu    String @default("Oi, {nome}! Tudo certo? Vi que você deu uma olhada no orçamento. Ficou alguma dúvida ou quer ajustar alguma coisa? É só me falar que a gente acerta 🙂")
  msgCobranca2NaoAbriu String @default("Oi, {nome}, tudo bem? Passando só pra confirmar se o orçamento chegou certinho pra você. Ele fica válido até {validade}. O link é este: {link}")
  msgCobranca2Abriu    String @default("Oi, {nome}! Queria saber se o orçamento ainda faz sentido pra você. Se o valor ou o prazo não encaixou, me conta que eu vejo o que dá pra fazer. Ele vale até {validade}.")

  cobrancas Cobranca[]
  escolhas  EscolhaCliente[]

  logo           EmpresaLogo?
  usuario        Usuario?
  sessoes        Sessao[]
  clientes       Cliente[]
  itens          Item[]
  orcamentos     Orcamento[]
  orcamentoItens OrcamentoItem[]
}

// A imagem do logo fica no próprio banco, separada da Empresa para não ser carregada
// à toa em toda consulta. É servida pelo endereço /logo/<empresaId> (src/app/logo).
model EmpresaLogo {
  empresaId    String   @id
  dados        Bytes // a imagem em si
  tipo         String // "image/png", "image/jpeg" ou "image/webp"
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

// Quem faz login. Um usuário por empresa (por isso empresaId é @unique).
model Usuario {
  id               String    @id @default(cuid())
  empresaId        String    @unique
  email            String    @unique // guardado sempre em minúsculas
  senhaHash        String // a senha NUNCA é guardada; só este "resumo" embaralhado dela
  tentativasFalhas Int       @default(0) // senhas erradas seguidas
  bloqueadoAte     DateTime? // após 5 erros seguidos, o login fica travado por 15 minutos
  criadoEm         DateTime  @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  sessoes Sessao[]
}

// Cada login aberto (um celular, um computador...). O navegador guarda um código
// secreto num cookie; aqui fica só o "resumo" (hash) desse código.
model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  empresaId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([usuarioId])
}

model Cliente {
  id         String   @id @default(cuid())
  empresaId  String
  nome       String
  telefone   String?
  observacao String?
  criadoEm   DateTime @default(now())

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  orcamentos Orcamento[]

  @@index([empresaId, nome])
}

// Item do catálogo: o que a empresa costuma vender (produto ou serviço).
model Item {
  id        String @id @default(cuid())
  empresaId String
  descricao String
  preco     Int // em centavos
  unidade   String // ex.: "un", "m²", "h", "kg"
  // Custo padrão por unidade, em centavos (opcional). INFORMAÇÃO INTERNA: sugerido ao
  // montar o orçamento e usado no cálculo de margem; nunca vai para o cliente final.
  custo     Int?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, descricao])
}

// rascunho   -> criado, ainda não mandado
// enviado    -> mandado pelo WhatsApp
// aberto     -> o cliente abriu o link (automático)
// respondido -> o cliente respondeu (marcado à mão)
// fechado    -> virou venda (marcado à mão)
// perdido    -> não virou venda (à mão, ou automático após o prazo de cobrança)
enum StatusOrcamento {
  rascunho
  enviado
  aberto
  respondido
  fechado
  perdido
}

model Orcamento {
  id         String          @id @default(cuid())
  empresaId  String
  clienteId  String
  numero     Int // sequencial por empresa: 1, 2, 3...
  total      Int // em centavos: soma dos itens INCLUÍDOS (muda quando o cliente troca uma opção)
  observacao String?
  validoAte  DateTime
  status     StatusOrcamento @default(rascunho)
  criadoEm   DateTime        @default(now())
  enviadoEm  DateTime? // PRIMEIRO envio; é daqui que a regra de cobrança conta os dias

  // Código secreto do link público (/orcamento/<token>). O próprio banco sorteia
  // 64 caracteres aleatórios; é impossível adivinhar o link de outro orçamento.
  token String @unique @default(dbgenerated("replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '')"))

  // Quando o cliente abriu a página pública pela primeira vez, e quantas vezes abriu.
  // Aberturas com menos de 30 minutos de diferença contam como uma só (ver src/lib/abertura.ts).
  abertoEm         DateTime?
  vezesAberto      Int       @default(0)
  ultimaAberturaEm DateTime?

  empresa   Empresa         @relation(fields: [empresaId], references: [id])
  cliente   Cliente         @relation(fields: [clienteId], references: [id])
  itens     OrcamentoItem[]
  cobrancas Cobranca[]
  escolhas  EscolhaCliente[]

  @@unique([empresaId, numero]) // duas empresas podem ter o orçamento nº 1, a mesma empresa não
  @@index([empresaId, criadoEm])
}

// Linha de um orçamento. Guarda uma CÓPIA da descrição e do preço, e não um link
// para o catálogo: se o preço do catálogo mudar amanhã, o orçamento antigo não muda.
model OrcamentoItem {
  id            String  @id @default(cuid())
  empresaId     String
  orcamentoId   String
  descricao     String
  quantidade    Decimal @db.Decimal(10, 3) // aceita 2,5 m² ou 1,5 h
  precoUnitario Int // em centavos
  subtotal      Int // em centavos: arredondamento de quantidade × precoUnitario
  // Custo por unidade, em centavos (opcional). INFORMAÇÃO INTERNA: nunca pode aparecer na
  // página pública nem no PDF. Por isso aquelas telas pedem ao banco só os campos que mostram.
  custoUnitario Int?

  // OPÇÕES QUE O CLIENTE ESCOLHE (ver TipoItem). Orçamentos antigos: tudo "fixo" e incluído.
  tipo     TipoItem @default(fixo)
  grupo    String? // só para "opcao": o nome do grupo de escolha, ex.: "Material"
  padrao   Boolean  @default(false) // "opcao": a que a empresa deixou marcada no grupo
  // Entra no total AGORA? fixo: sempre. opcao: a escolhida no grupo (começa pela padrão).
  // adicional: se o cliente marcou (começa desmarcado). Muda quando o cliente escolhe.
  incluido Boolean  @default(true)

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
}

// fixo      -> sempre incluído (o comportamento de sempre)
// opcao     -> faz parte de um grupo (ex.: "Material"); o cliente escolhe UM do grupo
// adicional -> o cliente marca ou desmarca à vontade
enum TipoItem {
  fixo
  opcao
  adicional
}

// Cada vez que o cliente muda as opções na página pública, uma linha aqui: o que ficou
// escolhido e quando. Serve para a empresa ver a escolha e se o cliente ficou trocando
// (sinal de dúvida de preço, mostrado na cobrança).
model EscolhaCliente {
  id          String   @id @default(cuid())
  empresaId   String
  orcamentoId String
  resumo      String // ex.: "Material: Madeira nobre · + Iluminação em LED interna"
  total       Int // total com esta escolha, em centavos
  criadaEm    DateTime @default(now())

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId, criadaEm])
}

// Registro de cada cobrança enviada pela tela "Cobrar hoje".
// É assim que o sistema sabe que a 1ª (ou a 2ª) cobrança de um orçamento já foi feita
// e não a mostra de novo.
model Cobranca {
  id          String   @id @default(cuid())
  empresaId   String
  orcamentoId String
  etapa       Int // 1 = primeira cobrança, 2 = segunda
  mensagem    String // o texto que foi enviado (depois de editado)
  enviadaEm   DateTime @default(now())

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@unique([orcamentoId, etapa]) // cada etapa uma vez só por orçamento
}
