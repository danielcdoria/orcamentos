// Descrição das tabelas do banco. Cada "model" vira uma tabela.
// Depois de mudar este arquivo, rode: npx prisma migrate dev --name descricao-da-mudanca

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// REGRAS DO PROJETO
// 1. Dinheiro sempre em CENTAVOS, como Int. R$ 12,50 é guardado como 1250.
// 2. Todo registro tem empresaId, e toda consulta filtra por ele.
//    É isso que permite várias empresas usando o mesmo sistema sem ver os dados umas das outras.

model Empresa {
  id                String   @id @default(cuid())
  nome              String
  logoUrl           String?
  telefone          String?
  condicaoPagamento String? // ex.: "50% na aprovação, 50% na entrega"
  diasValidade      Int      @default(15) // validade padrão dos orçamentos, em dias
  criadoEm          DateTime @default(now())

  usuario        Usuario?
  sessoes        Sessao[]
  clientes       Cliente[]
  itens          Item[]
  orcamentos     Orcamento[]
  orcamentoItens OrcamentoItem[]
}

// Quem faz login. Um usuário por empresa (por isso empresaId é @unique).
model Usuario {
  id               String    @id @default(cuid())
  empresaId        String    @unique
  email            String    @unique // guardado sempre em minúsculas
  senhaHash        String // a senha NUNCA é guardada; só este "resumo" embaralhado dela
  tentativasFalhas Int       @default(0) // senhas erradas seguidas
  bloqueadoAte     DateTime? // após 5 erros seguidos, o login fica travado por 15 minutos
  criadoEm         DateTime  @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  sessoes Sessao[]
}

// Cada login aberto (um celular, um computador...). O navegador guarda um código
// secreto num cookie; aqui fica só o "resumo" (hash) desse código.
model Sessao {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  usuarioId String
  empresaId String
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([usuarioId])
}

model Cliente {
  id         String   @id @default(cuid())
  empresaId  String
  nome       String
  telefone   String?
  observacao String?
  criadoEm   DateTime @default(now())

  empresa    Empresa     @relation(fields: [empresaId], references: [id])
  orcamentos Orcamento[]

  @@index([empresaId, nome])
}

// Item do catálogo: o que a empresa costuma vender (produto ou serviço).
model Item {
  id        String @id @default(cuid())
  empresaId String
  descricao String
  preco     Int // em centavos
  unidade   String // ex.: "un", "m²", "h", "kg"

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@index([empresaId, descricao])
}

enum StatusOrcamento {
  rascunho
  enviado
}

model Orcamento {
  id         String          @id @default(cuid())
  empresaId  String
  clienteId  String
  numero     Int // sequencial por empresa: 1, 2, 3...
  total      Int // em centavos (soma dos subtotais)
  observacao String?
  validoAte  DateTime
  status     StatusOrcamento @default(rascunho)
  criadoEm   DateTime        @default(now())

  // Código secreto do link público (/orcamento/<token>). O próprio banco sorteia
  // 64 caracteres aleatórios; é impossível adivinhar o link de outro orçamento.
  token String @unique @default(dbgenerated("replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '')"))

  empresa Empresa         @relation(fields: [empresaId], references: [id])
  cliente Cliente         @relation(fields: [clienteId], references: [id])
  itens   OrcamentoItem[]

  @@unique([empresaId, numero]) // duas empresas podem ter o orçamento nº 1, a mesma empresa não
  @@index([empresaId, criadoEm])
}

// Linha de um orçamento. Guarda uma CÓPIA da descrição e do preço, e não um link
// para o catálogo: se o preço do catálogo mudar amanhã, o orçamento antigo não muda.
model OrcamentoItem {
  id            String  @id @default(cuid())
  empresaId     String
  orcamentoId   String
  descricao     String
  quantidade    Decimal @db.Decimal(10, 3) // aceita 2,5 m² ou 1,5 h
  precoUnitario Int // em centavos
  subtotal      Int // em centavos: arredondamento de quantidade × precoUnitario

  empresa   Empresa   @relation(fields: [empresaId], references: [id])
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
}
